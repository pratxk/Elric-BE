# Elric backend — environment template. Copy to .env and fill in.
# NEVER commit a real .env or real keys.

# Database: Neon Postgres in production; leave unset for local SQLite dev.
DATABASE_URL=

# Gemini API keys (extraction). Primary is tried first, secondary on 429.
# No key configured -> extraction fails cleanly with a clear error; nothing
# is ever faked.
GEMINI_API_KEY=
GEMINI_API_KEY_SECONDARY=

# Gemini model for structured extraction.
GEMINI_MODEL=gemini-2.5-flash

# Auto-approve ceiling (INR) for clean matches.
AUTO_APPROVE_LIMIT_INR=500000

# LangSmith (optional, observability only).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=elric

# Axiom (optional, log shipping).
AXIOM_TOKEN=
AXIOM_DATASET=
