# Elric backend — environment template. Copy to .env and fill in.
# NEVER commit a real .env or real keys.

# Database: Neon Postgres in production; leave unset for local SQLite dev.
DATABASE_URL=

# Gemini API keys (extraction). Primary is tried first, secondary on 429.
# No key configured -> extraction fails cleanly with a clear error; nothing
# is ever faked.
GEMINI_API_KEY=
GEMINI_API_KEY_SECONDARY=

# Gemini model for structured extraction.
# gemini-3.8-flash since v1.1 (2026-11-15): gemini-2.5-flash is being
# retired and 404s intermittently ("no longer available to new users").
GEMINI_MODEL=gemini-3.8-flash

# JWT secret for access-token signing (v1.1). REQUIRED — the server
# refuses to start without it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# and paste the value here (never commit a real .env).
JWT_SECRET=

# Auto-approve ceiling (INR) for clean matches.
# This is only the DEFAULT: each user's own settings row overrides it
# at request time (GET/PUT /api/settings).
AUTO_APPROVE_LIMIT_INR=500000

# LangSmith (optional, observability only).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=elric

# Axiom (optional, log shipping).
AXIOM_TOKEN=
AXIOM_DATASET=
